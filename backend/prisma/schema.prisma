datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ConnectivityStatus {
  ONLINE
  OFFLINE
}

enum SeverityLevel {
  NORMAL
  WARNING
  HIGH_RISK
  CRITICAL
}

enum IncidentStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model Worker {
  workerId          String           @id @map("worker_id")
  name              String
  assignedZone      String           @map("assigned_zone")
  assignedHelmetId  String?          @unique @map("assigned_helmet_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  helmet            Helmet?          @relation(fields: [assignedHelmetId], references: [helmetId])
  readings          SensorReading[]
  incidents         Incident[]

  @@map("workers")
}

model Helmet {
  helmetId           String             @id @map("helmet_id")
  connectivityStatus ConnectivityStatus @default(OFFLINE) @map("connectivity_status")
  lastSeen           DateTime           @default(now()) @map("last_seen")
  assignedWorkerId   String?            @unique @map("assigned_worker_id")

  worker             Worker?
  readings           SensorReading[]
  incidents          Incident[]

  @@map("helmets")
}

model SensorReading {
  readingId          Int       @id @default(autoincrement()) @map("reading_id")
  helmetId           String    @map("helmet_id")
  workerId           String    @map("worker_id")
  heartRate          Float?    @map("heart_rate")
  spo2               Float?    @map("spo2")
  gasRaw             Int?      @map("gas_raw")
  temperature        Float?    @map("temperature")
  humidity           Float?    @map("humidity")
  fallDetected       Boolean   @default(false) @map("fall_detected")
  inactivityDetected Boolean   @default(false) @map("inactivity_detected")
  timestamp          DateTime  @default(now()) @map("timestamp")
  isSimulated        Boolean?  @map("is_simulated")

  helmet             Helmet    @relation(fields: [helmetId], references: [helmetId])
  worker             Worker    @relation(fields: [workerId], references: [workerId])

  @@index([workerId, timestamp])
  @@index([helmetId, timestamp])
  @@map("sensor_readings")
}

model Incident {
  incidentId     String         @id @default(uuid()) @map("incident_id")
  workerId       String         @map("worker_id")
  helmetId       String         @map("helmet_id")
  incidentType   String         @map("incident_type")
  severity       SeverityLevel  @default(WARNING) @map("severity")
  description    String         @map("description")
  detectedAt     DateTime       @default(now()) @map("detected_at")
  acknowledgedAt DateTime?      @map("acknowledged_at")
  acknowledgedBy String?        @map("acknowledged_by")
  resolvedAt     DateTime?      @map("resolved_at")
  status         IncidentStatus @default(ACTIVE) @map("status")
  isSimulated    Boolean?       @map("is_simulated")

  worker         Worker         @relation(fields: [workerId], references: [workerId])
  helmet         Helmet         @relation(fields: [helmetId], references: [helmetId])
  alertReceipts  AlertReceipt[]

  @@index([status])
  @@index([severity])
  @@index([workerId])
  @@index([detectedAt])
  @@map("incidents")
}

// An application acknowledgement is sent only once this receipt commits with its incident.
model AlertReceipt {
  helmetId     String    @map("helmet_id")
  eventId      String    @map("event_id")
  workerId     String    @map("worker_id")
  isSimulated  Boolean?  @map("is_simulated")
  incidentId   String    @map("incident_id")
  receivedAt   DateTime  @default(now()) @map("received_at")

  incident     Incident @relation(fields: [incidentId], references: [incidentId], onDelete: Cascade)

  @@id([helmetId, eventId])
  @@index([incidentId])
  @@map("alert_receipts")
}

model RegionalArticle {
  id                 String    @id @default(uuid()) @map("id")
  externalId         String?   @unique @map("external_id")
  url                String    @unique @map("url")
  title              String    @map("title")
  source             String    @map("source")
  author             String?   @map("author")
  publishedAt        DateTime  @map("published_at")
  retrievedAt        DateTime  @default(now()) @map("retrieved_at")
  summary            String    @map("summary")
  impactDescription  String    @map("impact_description")
  locationName       String    @map("location_name")
  coordinates        String?   @map("coordinates")
  distanceKm         Float     @map("distance_km")
  direction          String    @default("NE") @map("direction")
  geoScope           String    @default("NEARBY") @map("geo_scope") // NEARBY, LOCAL_AREA, REGIONAL
  category           String    @map("category") // Blasting, Excavation, Heavy Transport, Drilling, Structural Concrete
  internalCategory   String?   @map("internal_category")
  riskLevel          String    @default("MODERATE") @map("risk_level") // LOW, MODERATE, HIGH
  status             String    @default("ACTIVE NOW") @map("status") // ACTIVE NOW, SCHEDULED, STANDBY
  relevanceScore     Float     @default(50.0) @map("relevance_score")
  isVerified         Boolean   @default(true) @map("is_verified")

  @@index([geoScope])
  @@index([category])
  @@index([publishedAt])
  @@index([relevanceScore])
  @@map("regional_articles")
}
